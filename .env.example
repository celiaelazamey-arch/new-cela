# ============================================================
#  new-cela — نموذج متغيرات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم.
#  ⚠️ لا ترفع ملف .env إلى Git أبداً — المفاتيح تبقى خارج الكود.
# ============================================================

# --- مفاتيح مجانية (مطلوب مفتاح واحد على الأقل) ---
# Gemini (مجاني):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (مجاني):    https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (اختياري، نماذج مجانية): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- إعدادات الوكيل (اختيارية) ---
AGENT_PRIMARY_MODEL=gemini-2.5-flash
AGENT_FALLBACK_MODEL=llama-3.3-70b-versatile
AGENT_MAX_STEPS=15
AGENT_TIMEOUT=60

# --- أتمتة المتصفح (اختياري — راجع SECURITY.md قبل التفعيل) ---
# pip install -r requirements-browser.txt  ثم  --mode browser
# ملاحظة: هذا الملف يجلب aiohttp 3.12.15 ذا الثغرات المعروفة؛ لا تُثبّته
# في بيئة إنتاج حساسة قبل صدور إصدار مُصلَح من browser-use.

# --- الذاكرة الاستراتيجية (RAG محلي بلا خدمة خارجية) ---
# المسار النسبي لملف الذاكرة (JSONL). ضعه خارج Git — مستثنى في .gitignore.
AGENT_MEMORY_PATH=.agent_memory/memory.jsonl
AGENT_MEMORY_TOP_K=4
AGENT_MEMORY_MAX_ENTRIES=500
AGENT_MEMORY_MIN_SCORE=0.05

# --- سجل التشغيلات (تقرأه لوحة المتابعة) ---
AGENT_RUNS_PATH=.agent_runs
AGENT_RUNS_KEEP=50

# --- فهرس المعرفة وأبحاث مجانية (اختياري، بلا مفاتيح) ---
AGENT_CORPUS_PATH=.agent_knowledge/corpus.jsonl
AGENT_PAPERS_CACHE=.agent_knowledge/papers_cache.json

# --- Google Drive (قراءة فقط، اختياري) ---
# استخدم واحداً فقط؛ الصلاحية المطلوبة drive.readonly ولا شيء غيرها.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=1_37p_eYVVPb0uiWYRJaQioDgQAuyHooX
# للكتابة (ثنائي الاتجاه) — رمز OAuth بنطاق drive.file فقط:
GOOGLE_DRIVE_WRITE_TOKEN=
